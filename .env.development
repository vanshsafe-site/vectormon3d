# Development Environment Variables
# Used only during local development with `npm run dev`

# Application
VITE_APP_TITLE=Vectormon Wilds (Dev)
VITE_APP_DESCRIPTION=Explore the Great Forest, discover Vectormons, and build your collection
VITE_API_BASE_URL=http://localhost:5173

# Analytics
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_TRACKING=false

# CDN Configuration
VITE_CDN_URL=http://localhost:5173

# Performance
VITE_PRELOAD_ASSETS=false
VITE_LAZY_LOAD_MODULES=true
VITE_ENABLE_COMPRESSION=false
