# Environment Variables Template
# Copy this file to .env.production and .env.development, then fill in your values

# Application
VITE_APP_TITLE=Vectormon Wilds
VITE_APP_DESCRIPTION=Explore the Great Forest, discover Vectormons, and build your collection
VITE_API_BASE_URL=https://vectormon3d.vercel.app

# Analytics (Add your Google Analytics ID)
VITE_GOOGLE_ANALYTICS_ID=G_XXXXXXXXXX

# Error Tracking (Add your Sentry DSN if using)
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_TRACKING=false

# CDN Configuration
VITE_CDN_URL=https://vectormon3d.vercel.app

# Performance Optimization
VITE_PRELOAD_ASSETS=true
VITE_LAZY_LOAD_MODULES=true
VITE_ENABLE_COMPRESSION=true
